# Copy this file to secrets.env and fill in values. secrets.env is gitignored.

# Google Analytics 4
GA4_SERVICE_ACCOUNT_JSON_PATH=
GA4_PROPERTY_ID=

# Google Search Console (future)
GSC_SERVICE_ACCOUNT_JSON_PATH=

# Reddit API (PRAW)
